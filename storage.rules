rules_version = '2';

// Reglas de Firebase Storage para Ruta Local
// Las imágenes se guardan en las carpetas: fotos/ y perfiles/
service firebase.storage {
  match /b/{bucket}/o {
    // Lectura pública de todas las imágenes (para que cualquiera pueda verlas)
    match /{allPaths=**} {
      allow read: if true;
    }

    // Cualquier usuario autenticado puede subir imágenes a fotos/ y perfiles/
    match /fotos/{fileName} {
      allow write: if request.auth != null;
    }

    match /perfiles/{fileName} {
      allow write: if request.auth != null;
    }
  }
}
